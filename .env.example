# --- Obligatorias ---
MOODLE_URL=https://moodle.example.org
# Clave de servicio: la presenta Odoo en "Authorization: Bearer ..."  (openssl rand -hex 32)
API_KEY=

# --- Base de datos de Odoo (solo lectura de 4 columnas de res_users) ---
# Rol con permisos por columna: ver sql/grants.sql
ODOO_DB_DSN=postgres://maya_gateway:CAMBIAR@db:5432/odoo?sslmode=require
ODOO_DB_MAX_CONNS=10
# CLAVE con la que el gateway cifra y descifra los tokens. Esta variable NO contiene tokens:
# los tokens están ya cifrados en res_users.moodle_token_enc; aquí solo está la clave.
# Formato: <id>:<clave en base64>
#   1. Genera una clave:        openssl rand -base64 32
#   2. Ponla detrás del id:     TOKEN_ENC_KEYS=v1:p3YbExample0000000000000000000000000000000=
# El id ("v1" es solo un nombre; vale cualquier cosa de 1 a 8 caracteres a-z0-9) se guarda
# junto a cada token cifrado para saber con qué clave se cifró. Sirve para ROTAR la clave sin
# que nadie tenga que volver a identificarse: se pone la nueva delante y se conserva la antigua.
#   TOKEN_ENC_KEYS=v2:<clave nueva>,v1:<clave antigua>   (la primera cifra; todas descifran)
TOKEN_ENC_KEYS=v1:PEGA_AQUI_LA_CLAVE_BASE64

# --- Cuentas de servicio (administradores) ---
# Fichero JSON con la contraseña de Moodle de cada administrador, por id de usuario de Odoo:
#   {"2": {"password": "..."}}
# Móntalo como secret (Docker/Kubernetes), nunca en el repositorio. Su nombre de usuario de
# Moodle se lee de res_users.moodle_username. Más adelante, Vault.
# Vacío = no hay cuentas de servicio.
SERVICE_CREDENTIALS_FILE=

# --- Servidor ---
LISTEN_ADDR=:8080
REQUEST_TIMEOUT=30s
LOG_LEVEL=info

# --- Conexión a Moodle ---
# Máximo de peticiones simultáneas hacia Moodle (también tamaño del pool de conexiones)
MOODLE_MAX_CONCURRENCY=30
MOODLE_ATTEMPT_TIMEOUT=15s
# Reintentos extra (solo operaciones idempotentes)
MOODLE_MAX_RETRIES=2
# Shortname del servicio web usado en login/token.php
MOODLE_SERVICE=moodle_mobile_app
